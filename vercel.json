{
  "buildCommand": "pnpm --filter @workspace/db run push && pnpm --filter @workspace/library-app run build",
  "outputDirectory": "artifacts/library-app/dist/public",
  "functions": {
    "api/index.ts": {
      "maxDuration": 30
    }
  },
  "env": {
    "PORT": "3000",
    "BASE_PATH": "/"
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.ts" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
